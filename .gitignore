# Cargo build output
target

# Generated Go local-profile module files
benchmarks/coraza/go/local.mod
benchmarks/coraza/go/local.sum

# Test artifacts
**/*.db

# Fetched OWASP CRS tree for the envoy-coraza `embed-crs` feature
envoy-coraza/crs/

# Staged WASM filters for GoReleaser releases (see .goreleaser.yaml)
release-artifacts/

# GoReleaser output
dist/

# Rustfmt backup files
**/*.rs.bk

# Python
__pycache__/
*.pyc

# MSVC debugging symbols
*.pdb

# Cargo mutants output
**/mutants.out*/

# LLVM coverage artifacts
coverage/
coverage.json
*.profraw
*.profdata

# IDEs
.idea/

# Dotdirs (allow .cargo/, .github/, .claude/, and .hooks/)
.*/
!.cargo/
!.github/
!.claude/
!.hooks/
.claude/*
!.claude/CLAUDE.md

# Docs are markdown only
docs/**/*
!docs/**/*.md
!docs/**/
